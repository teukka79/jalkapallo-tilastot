{
  "name": "jalkapallotilastot",
  "productName": "Jalkapallotilastot",
  "version": "0.2.1",
  "description": "Jalkapallon pelaajatilastot, sarjataulukot, otteluohjelmat ja kertoimet yhdelletoista sarjalle",
  "author": "Teukka",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fi.teukka.jalkapallolaukaustilasto",
    "productName": "Jalkapallotilastot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "understat.js",
      "renderer/**/*",
      "assets/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Jalkapallotilastot",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "artifactName": "Jalkapallotilastot-Setup-${version}.exe"
  }
}
